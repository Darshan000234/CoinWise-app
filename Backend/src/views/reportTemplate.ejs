<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>CoinWise Monthly Report</title>
    <style>
      body {
        font-family: "Segoe UI", Arial, sans-serif;
        padding: 40px;
        color: #222;
        background: #fff;
        line-height: 1.6;
      }

      h1, h2, h3, h4 {
        margin: 0;
        color: #111;
      }

      .header {
        text-align: center;
        border-bottom: 2px solid #ccc;
        padding-bottom: 10px;
        margin-bottom: 25px;
      }

      .section {
        margin-bottom: 25px;
      }

      .section-title {
        font-weight: bold;
        font-size: 16px;
        margin-bottom: 8px;
      }

      .summary {
        background: #f8f9fa;
        padding: 15px 20px;
        border-radius: 8px;
      }

      .chart-grid {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
      }

      .chart {
        flex: 1 1 48%;
        background: #f8f8f8;
        border-radius: 10px;
        padding: 10px;
        text-align: center;
        page-break-inside: avoid;
      }

      .chart img {
        width: 100%;
        max-height: 240px;
        border-radius: 6px;
        object-fit: contain;
      }

      ul {
        margin: 0;
        padding-left: 20px;
      }

      footer {
        text-align: center;
        font-size: 12px;
        color: #555;
        margin-top: 30px;
        border-top: 1px solid #ccc;
        padding-top: 10px;
      }
    </style>
  </head>

  <body>
    <div class="header">
      <h1>📘 COINWISE MONTHLY FINANCIAL REPORT</h1>
      <p>👤 <b>User:</b> <%= name %></p>
      <p>📅 <b>Month:</b> <%= month %></p>
    </div>

    <div class="section summary">
      <div class="section-title">💰 Summary:</div>
      <ul>
        <li>Total Income: ₹<%= totalIncome.toLocaleString() %></li>
        <li>Total Spend: ₹<%= totalSpend.toLocaleString() %></li>
        <li>Net Savings: ₹<%= totalSaved.toLocaleString() %></li>
      </ul>
    </div>

    <div class="section">
      <div class="section-title">📊 Category Breakdown:</div>
      <ul>
        <% categoryData.forEach(c => { %>
          <li><%= c._id %>: ₹<%= c.totalAmount.toLocaleString() %></li>
        <% }) %>
      </ul>
    </div>

    <div class="section">
      <div class="section-title">📈 Insights:</div>
      <ul>
        <% if (insight && insight.length > 0) { %>
          <% insight.forEach(i => { %>
            <li><%= i %></li>
          <% }) %>
        <% } else { %>
          <li>No specific insights for this month.</li>
        <% } %>
      </ul>
    </div>


    <footer>
      🕒 Generated automatically on <%= generatedAt %><br />
      CoinWise © 2025 | Your Personal Finance Assistant
    </footer>
  </body>
</html>
